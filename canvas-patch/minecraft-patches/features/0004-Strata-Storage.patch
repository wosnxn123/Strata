diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/io/datacontroller/ChunkDataController.java b/ca/spottedleaf/moonrise/patches/chunk_system/io/datacontroller/ChunkDataController.java
index a3250959137c559ddfc78833b50f0aa51b2639a7..f5546362a919b2ef65a9f3561f39baec77753e9c 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/io/datacontroller/ChunkDataController.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/io/datacontroller/ChunkDataController.java
@@ -25,6 +25,13 @@ public final class ChunkDataController extends MoonriseRegionFileIO.RegionDataCo
 
     @Override
     public WriteData startWrite(final int chunkX, final int chunkZ, final CompoundTag compound) throws IOException {
+        // Canvas start - Strata storage routing
+        final io.canvasmc.canvas.strata.StrataWorld strata = this.world.canvas$strataWorld();
+        if (strata != null && strata.write(chunkX, chunkZ, dev.strata.bridge.StrataNative.TYPE_CHUNK, compound)) {
+            // the record is now owned by the vstore; DELETE clears the stale Anvil copy (no-op when the region file is absent)
+            return new WriteData(compound, WriteData.WriteResult.DELETE, null, null);
+        }
+        // Canvas end - Strata storage routing
         return ((ChunkSystemRegionFileStorage)this.getCache()).moonrise$startWrite(chunkX, chunkZ, compound);
     }
 
@@ -35,6 +42,23 @@ public final class ChunkDataController extends MoonriseRegionFileIO.RegionDataCo
 
     @Override
     public ReadData readData(final int chunkX, final int chunkZ) throws IOException {
+        // Canvas start - Strata storage routing
+        final io.canvasmc.canvas.strata.StrataWorld strata = this.world.canvas$strataWorld();
+        if (strata != null) {
+            final io.canvasmc.canvas.strata.StrataWorld.ReadOutcome outcome = strata.read(chunkX, chunkZ, dev.strata.bridge.StrataNative.TYPE_CHUNK);
+            switch (outcome.state()) {
+                case HIT -> {
+                    return new ReadData(ReadData.ReadResult.SYNC_READ, null, outcome.tag(), 0);
+                }
+                case DELETED -> {
+                    return new ReadData(ReadData.ReadResult.NO_DATA, null, null, 0);
+                }
+                case MISS -> {
+                    // not in the vstore: fall through to Anvil
+                }
+            }
+        }
+        // Canvas end - Strata storage routing
         return ((ChunkSystemRegionFileStorage)this.getCache()).moonrise$readData(chunkX, chunkZ);
     }
 
