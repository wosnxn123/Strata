+        // Canvas start - Strata storage
+        // Every level (overworld/nether/end, including plugin-created worlds)
+        // resolves its own dimension directory and gets its own vstore at
+        // <dimDir>/vstore; config (strata.properties) is read from the world root.
+        io.canvasmc.canvas.strata.StrataWorld canvas$strataWorldInit = null;
+        if (levelStorage != null) {
+            final java.nio.file.Path canvas$strataDimDir = levelStorage.getDimensionPath(dimension);
+            final java.nio.file.Path canvas$strataConfigRoot = levelStorage.getLevelPath(net.minecraft.world.level.storage.LevelResource.ROOT);
+            try {
+                canvas$strataWorldInit = io.canvasmc.canvas.strata.StrataWorld.openFor(canvas$strataConfigRoot, canvas$strataDimDir, dimension == net.minecraft.world.level.Level.OVERWORLD);
+            } catch (final IllegalStateException ex) {
+                // fail-closed: vstore present but Strata not active - never boot on stale Anvil silently
+                throw new IllegalStateException("[Strata] cannot start level " + dimension.identifier() + ": " + ex.getMessage(), ex);
+            }
+        }
+        this.canvas$strataWorld = canvas$strataWorldInit;
